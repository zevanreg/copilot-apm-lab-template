{
  "name": "Northstar APM lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/powershell:2.0.3": {}
  },
    "mounts": [
      "source=northstar-${devcontainerId}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
  "remoteUser": "node",
  "postCreateCommand": ["pwsh", "-NoProfile", "-File", ".devcontainer/setup.ps1"],
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Northstar API",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-vscode.powershell"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "PowerShell",
        "terminal.integrated.profiles.linux": {
          "PowerShell": {
            "path": "pwsh",
            "args": ["-NoLogo"]
          }
        }
      }
    }
  }
}